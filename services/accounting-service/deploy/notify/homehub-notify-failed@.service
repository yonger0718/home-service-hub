[Unit]
Description=HomeHub accounting notifier: deliver the failure of %i

[Service]
Type=oneshot
WorkingDirectory=%h/releases/home-hub-notify/current/services/accounting-service
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Taipei
UMask=0077
ExecStart=%h/releases/home-hub-notify/venv/bin/python -m notify failed %i
Nice=10

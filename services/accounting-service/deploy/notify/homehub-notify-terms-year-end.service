[Unit]
Description=HomeHub accounting notifier: reward terms check (year-end)
Conflicts=homehub-notify-terms-monthly.service
OnFailure=homehub-notify-failed@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/releases/home-hub-notify/current/services/accounting-service
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Taipei
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=%h/releases/home-hub-notify/venv/bin/python -m notify terms --send --cause year-end
TimeoutStartSec=1900
Nice=10

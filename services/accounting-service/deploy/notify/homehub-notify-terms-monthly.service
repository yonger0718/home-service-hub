[Unit]
Description=HomeHub accounting notifier: reward terms check (monthly)
Conflicts=homehub-notify-terms-year-end.service
OnFailure=homehub-notify-failed@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/releases/home-hub-notify/current/services/accounting-service
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Taipei
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=%h/releases/home-hub-notify/venv/bin/python -m notify terms --send --cause monthly
TimeoutStartSec=1900
Nice=10
